{
  "version": 2,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/api/auth", "destination": "/api/auth.js" },
    { "source": "/api/datasources", "destination": "/api/datasources.js" },
    { "source": "/api/oauth", "destination": "/api/oauth.js" },
    { "source": "/api/oauth/callback", "destination": "/api/oauth.js" },
    { "source": "/api/oauth-callback", "destination": "/api/oauth-callback.js" },
    { "source": "/api/send", "destination": "/api/send.js" },
    { "source": "/api/user", "destination": "/api/user.js" },
    { "source": "/api/watchdog", "destination": "/api/watchdog.js" },
    { "source": "/api/admin-status", "destination": "/api/admin-status.js" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy/", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms/", "destination": "/terms.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
