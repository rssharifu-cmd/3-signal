{
  "version": 2,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ],
  "redirects": [{ "source": "/:path*", "has": [{ "type": "host", "value": "www.sharflow.online" }], "destination": "https://sharflow.online/:path*", "permanent": true }],
  "rewrites": [
    { "source": "/api/auth", "destination": "/api/auth.js" },
    { "source": "/api/datasources", "destination": "/api/datasources.js" },
    { "source": "/api/oauth", "destination": "/api/oauth.js" },
    { "source": "/api/oauth/callback", "destination": "/api/oauth.js" },
    { "source": "/api/oauth-callback", "destination": "/api/oauth-callback.js" },
    { "source": "/api/send", "destination": "/api/send.js" },
    { "source": "/api/user", "destination": "/api/user.js" },
    { "source": "/api/watchdog", "destination": "/api/watchdog.js" },
    { "source": "/api/admin-status", "destination": "/api/admin-status.js" },
    { "source": "/api/paddle-webhook", "destination": "/api/paddle-webhook.js" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy/", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms/", "destination": "/terms.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/pricing/", "destination": "/pricing.html" },
    { "source": "/refund", "destination": "/refund.html" },
    { "source": "/refund/", "destination": "/refund.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/about/", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/contact/", "destination": "/contact.html" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/", "has": [{ "type": "query", "key": "code" }], "destination": "/api/oauth-callback" }
  ]
}
